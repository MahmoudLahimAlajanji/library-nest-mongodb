generator client {
provider = "prisma-client"
output = "../src/generated/prisma"
moduleFormat = "cjs" 
}
datasource db {
provider = "postgresql"
}
model Course {
id Int @id @default(autoincrement())
name String
users User[]
}
model User {
id Int @id @default(autoincrement())
name String
courseId Int
course Course @relation(fields: [courseId], references: [id])
}